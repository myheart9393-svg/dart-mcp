{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myheart9393-svg/dart-mcp/valuation_schema.json",
  "title": "DART 가치평가 사례",
  "description": "합병·분할·영업양수도·주식교환·IPO 공시 한 건의 가치평가 내용. 원문에 없으면 null, 절대 추정하지 않는다. 숫자는 모두 {value, cite} 형태로 원문 위치를 붙인다. 문서: docs/valuation_schema.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["rcept_no", "original_rcept_no", "filing_type", "source_grade", "company", "deal",
               "external_valuation", "valuations", "conclusion", "sensitivity", "citations",
               "extracted_at", "extractor_version"],
  "properties": {
    "rcept_no": {"$ref": "#/$defs/rcept_no", "description": "추출에 쓴 접수번호(본문이 든 최신본, body_rcept_no)"},
    "original_rcept_no": {"anyOf": [{"$ref": "#/$defs/rcept_no"}, {"type": "null"}], "description": "최초 제출본. 정정이 없으면 rcept_no와 같다"},
    "related_rcept_nos": {"type": "array", "items": {"$ref": "#/$defs/rcept_no"}, "description": "같은 거래의 짝 공시(주요사항보고서↔증권신고서)"},
    "filing_type": {"enum": ["주요사항보고서", "증권신고서"]},
    "report_nm": {"type": ["string", "null"]},
    "source_grade": {"enum": ["full", "summary"], "description": "full=증권신고서 본문에 가정까지 있음, summary=주요사항보고서 5행 표와 결론만"},
    "company": {
      "type": "object", "additionalProperties": false, "required": ["corp_code", "name", "market"],
      "properties": {
        "corp_code": {"type": ["string", "null"], "pattern": "^\\d{8}$"},
        "name": {"type": "string"},
        "market": {"enum": ["유가증권", "코스닥", "코넥스", "기타", null]},
        "induty_code": {"type": ["string", "null"], "description": "기업개황 KSIC 업종코드(조회용)"}
      }
    },
    "deal": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "counterparty", "counterparty_listed", "related_party", "board_date", "regime"],
      "properties": {
        "type": {"enum": ["merger", "split", "split_merger", "business_transfer", "share_exchange", "ipo", "rights_offering"]},
        "counterparty": {"type": ["string", "null"], "description": "합병상대·양도인 등. IPO는 null"},
        "counterparty_listed": {"type": ["boolean", "null"]},
        "related_party": {"type": ["boolean", "null"], "description": "계열회사·최대주주 등 특수관계 거래 여부(원문의 '회사와의 관계'로 판단)"},
        "relation_text": {"type": ["string", "null"], "description": "원문 '회사와의 관계' 문자열 그대로"},
        "board_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}], "description": "이사회 결의일"},
        "regime": {"enum": ["기준시가", "공정가액(2026.12.9 개정)", "IPO", null],
                   "description": "합병가액 산정 체계. 2026.9.8 개정 자본시장법은 2026.12.9 이후 이사회 결의분부터 공정가액 기준"},
        "ratio_text": {"type": ["string", "null"], "description": "합병비율 등 원문 문자열"}
      }
    },
    "external_valuation": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "exemption_reason", "basis_text", "firm", "firm_type", "period",
                   "audit_committee_consent", "standards_cited"],
      "properties": {
        "required": {"type": ["boolean", "null"], "description": "원문 '외부평가 여부' 예→true, 아니오/미해당→false"},
        "exemption_reason": {"type": ["string", "null"]},
        "basis_text": {"type": ["string", "null"], "description": "'근거 및 사유' 원문 문자열 그대로(항 번호를 고치지 않는다)"},
        "firm": {"type": ["string", "null"]},
        "firm_type": {"enum": ["회계법인", "금융투자업자(인수업)", "신용평가회사", null]},
        "period": {"type": ["string", "null"], "description": "외부평가 기간 원문 그대로"},
        "audit_committee_consent": {"type": ["boolean", "null"], "description": "외부평가기관 선정에 감사위원회 동의(시행령 176조의5 ⑩). 원문에 없으면 null"},
        "standards_cited": {"type": "array", "items": {"type": "string"}, "description": "원문이 준수했다고 적은 기준(예: 외부평가업무 가이드라인(2009.6))"},
        "opinion_text": {"type": ["string", "null"], "description": "'외부평가 의견' 칸 요지(300자 이내 발췌)"},
        "cite": {"anyOf": [{"$ref": "#/$defs/cite"}, {"type": "null"}]}
      }
    },
    "valuations": {"type": "array", "items": {"$ref": "#/$defs/valuation"}},
    "conclusion": {
      "type": "object", "additionalProperties": false, "required": ["price_per_share", "range", "ratio", "opinion_text", "unit"],
      "properties": {
        "price_per_share": {"type": "array", "items": {"$ref": "#/$defs/priced"},
                            "description": "회사별 최종 주당 가액(합병가액·공모희망가 하단 등). 점 값"},
        "range": {"type": "array", "items": {"$ref": "#/$defs/ranged"}, "description": "범위로 제시된 결론(적정성 범위·공모가 밴드·영업가치 범위)"},
        "ratio": {"anyOf": [{"$ref": "#/$defs/num"}, {"type": "null"}], "description": "합병·교환비율(존속 1 기준 소멸회사 주식 수)"},
        "transaction_value": {"anyOf": [{"$ref": "#/$defs/num"}, {"type": "null"}], "description": "영업양수도가액 등 거래금액"},
        "opinion_text": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"], "description": "price_per_share·range의 기본 단위(원 등). 각 숫자의 unit이 우선"}
      }
    },
    "sensitivity": {"type": "array", "items": {"$ref": "#/$defs/sensitivity"}},
    "ipo": {"anyOf": [{"$ref": "#/$defs/ipo"}, {"type": "null"}]},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}, "description": "읽은 섹션 목록(참조 부록)"},
    "notes": {"type": "array", "items": {"type": "string"}, "description": "원문 한계·짝 공시 안내 등. 추정은 쓰지 않는다"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "extractor_version": {"type": "string"}
  },
  "$defs": {
    "rcept_no": {"type": "string", "pattern": "^\\d{14}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "cite": {
      "type": "object", "additionalProperties": false, "required": ["section_id", "offset", "file_id"],
      "properties": {
        "rcept_no": {"$ref": "#/$defs/rcept_no", "description": "사례의 rcept_no와 다른 공시에서 왔을 때만"},
        "section_id": {"type": "string"},
        "offset": {"type": "integer", "minimum": 0, "description": "그 섹션 텍스트 기준 offset(get_disclosure_section·find_tables와 같다)"},
        "file_id": {"type": "string"}
      }
    },
    "num": {
      "type": "object", "additionalProperties": false, "required": ["value", "cite"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "description": "원문 단위 그대로: 원·백만원·억원·%·배·주. 환산하지 않는다"},
        "text": {"type": ["string", "null"], "description": "원문 표기(예: \"8.1543%\", \"261,345\"). 검증 스크립트가 이 문자열을 찾는다"},
        "cite": {"anyOf": [{"$ref": "#/$defs/cite"}, {"type": "null"}]}
      },
      "if": {"properties": {"value": {"type": "number"}}},
      "then": {"properties": {"cite": {"$ref": "#/$defs/cite"}}}
    },
    "num_or_null": {"anyOf": [{"$ref": "#/$defs/num"}, {"type": "null"}]},
    "range": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/num_or_null"}, "max": {"$ref": "#/$defs/num_or_null"}}
    },
    "priced": {
      "type": "object", "additionalProperties": false, "required": ["company", "value"],
      "properties": {"company": {"type": "string"}, "basis": {"type": ["string", "null"], "description": "기준시가·자산가치·본질가치 등"},
                     "value": {"$ref": "#/$defs/num"}}
    },
    "ranged": {
      "type": "object", "additionalProperties": false, "required": ["label", "range"],
      "properties": {"label": {"type": "string"}, "subject": {"type": ["string", "null"]}, "range": {"$ref": "#/$defs/range"}}
    },
    "peer": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string"}, "value": {"$ref": "#/$defs/num_or_null"}, "note": {"type": ["string", "null"]}}
    },
    "valuation": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "target", "role", "method", "weights", "asset_value", "dcf", "relative", "result"],
      "description": "평가 주체 1곳 × 대상 회사 1곳 × 방법 1개. 주체나 대상이 다르면 원소를 나눈다",
      "properties": {
        "subject": {"type": "string", "description": "평가 주체(예: 이촌회계법인)"},
        "target": {"type": "string", "description": "평가 대상 회사·사업부"},
        "role": {"enum": ["외부평가", "재무자문", "주관사", "회사"], "description": "회사 = 합병당사회사가 제시·협의한 가액(평가기관이 아님)"},
        "method": {"enum": ["DCF", "DDM", "이익할인", "본질가치", "기준시가", "상대가치", "자산가치"]},
        "weights": {
          "anyOf": [{"type": "null"},
                    {"type": "object", "additionalProperties": false, "required": ["asset", "income"],
                     "properties": {"asset": {"type": "number"}, "income": {"type": "number"},
                                    "basis": {"type": ["string", "null"], "description": "원문 표기(\"1과 1.5\", \"40%·60%\")"}}}]
        },
        "asset_value": {
          "anyOf": [{"type": "null"},
                    {"type": "object", "additionalProperties": false,
                     "properties": {"per_share": {"$ref": "#/$defs/num_or_null"}, "total": {"$ref": "#/$defs/num_or_null"},
                                    "equity_book": {"$ref": "#/$defs/num_or_null"}, "adjustments": {"$ref": "#/$defs/num_or_null"},
                                    "shares": {"$ref": "#/$defs/num_or_null"}, "base_date": {"type": ["string", "null"]}}}]
        },
        "income_value": {"anyOf": [{"$ref": "#/$defs/num"}, {"type": "null"}],
                         "description": "본질가치 원소의 주당 수익가치(점 값). 범위만 있으면 null로 두고 result.range에"},
        "dcf": {
          "anyOf": [{"type": "null"},
                    {"type": "object", "additionalProperties": false,
                     "properties": {
                       "forecast_years": {"type": ["string", "null"], "description": "추정기간 원문(예: 2026–2035, 10개년)"},
                       "base_date": {"type": ["string", "null"]},
                       "wacc": {"$ref": "#/$defs/num_or_null"}, "rf": {"$ref": "#/$defs/num_or_null"},
                       "mrp": {"$ref": "#/$defs/num_or_null"}, "beta_unlevered": {"$ref": "#/$defs/num_or_null"},
                       "beta_levered": {"$ref": "#/$defs/num_or_null"}, "size_premium": {"$ref": "#/$defs/num_or_null"},
                       "ke": {"$ref": "#/$defs/num_or_null"},
                       "kd": {"anyOf": [{"$ref": "#/$defs/num"}, {"type": "null"}], "description": "세전 타인자본비용. 원문에 세후만 있으면 null로 두고 note에"},
                       "tax_rate": {"$ref": "#/$defs/num_or_null"}, "target_de": {"$ref": "#/$defs/num_or_null"},
                       "g": {"$ref": "#/$defs/num_or_null"},
                       "peers": {"type": "array", "items": {"$ref": "#/$defs/peer"}}}}]
        },
        "relative": {
          "anyOf": [{"type": "null"},
                    {"type": "object", "additionalProperties": false,
                     "properties": {"multiple_type": {"type": ["string", "null"], "description": "PER·PBR·EV/EBITDA 등"},
                                    "peers": {"type": "array", "items": {"$ref": "#/$defs/peer"}},
                                    "multiple": {"$ref": "#/$defs/num_or_null"},
                                    "applied_earnings": {"$ref": "#/$defs/num_or_null"},
                                    "discount_range": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]},
                                    "not_applied_reason": {"type": ["string", "null"]}}}]
        },
        "result": {
          "type": "object", "additionalProperties": false, "required": ["value", "unit", "range"],
          "properties": {"value": {"$ref": "#/$defs/num_or_null"}, "unit": {"type": ["string", "null"]},
                         "range": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]}}
        },
        "note": {"type": ["string", "null"]}
      }
    },
    "sensitivity": {
      "type": "object", "additionalProperties": false, "required": ["subject", "target", "variables", "range"],
      "properties": {"subject": {"type": "string"}, "target": {"type": "string"},
                     "variables": {"type": "string", "description": "예: WACC ±1.0%p, 영구성장률 ±1.0%p (0.5%p 간격)"},
                     "range": {"$ref": "#/$defs/range"}}
    },
    "ipo": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "underwriter": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "multiple_type": {"type": ["string", "null"]},
        "excluded_multiples": {"type": "array", "items": {"type": "string"}},
        "applied_earnings": {"$ref": "#/$defs/num_or_null"},
        "applied_earnings_basis": {"type": ["string", "null"], "description": "예: 2026년 2분기 LTM 조정 당기순이익"},
        "multiple": {"$ref": "#/$defs/num_or_null"},
        "shares": {"$ref": "#/$defs/num_or_null"},
        "value_per_share": {"$ref": "#/$defs/num_or_null"},
        "discount_range": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]},
        "price_band": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]},
        "peers": {"type": "array", "items": {"$ref": "#/$defs/peer"}},
        "external_comparison": {"type": ["string", "null"], "description": "외부평가(RCPS 공정가치 등)와 비교 서술 요지"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false, "required": ["rcept_no", "file_id", "section_id", "title", "chars_read"],
      "properties": {"rcept_no": {"$ref": "#/$defs/rcept_no"}, "file_id": {"type": "string"}, "section_id": {"type": "string"},
                     "title": {"type": ["string", "null"]}, "chars_read": {"type": "integer", "minimum": 0},
                     "how": {"type": ["string", "null"], "description": "find_tables / search / section 등"}}
    }
  }
}
